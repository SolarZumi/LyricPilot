{
  "manifest_version": 3,
  "name": "LyricPilot",
  "description": "导入歌词时间轴，选择网页播放按钮，通过按钮、空格或自定义按键自动对齐歌词。",
  "version": "0.4.6",
  "minimum_chrome_version": "123",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "打开 LyricPilot",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
